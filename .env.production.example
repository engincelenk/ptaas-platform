# ============================================================
# PTaaS Production Environment — copy to .env and fill values
# ============================================================
# Secrets (DB password, JWT, AES key, etc.) must ALSO be written
# to individual files under ./secrets/ — Docker secrets mount them
# at /run/secrets/<name> inside containers.
#
# ./secrets/db_password.txt         → strong random password
# ./secrets/jwt_secret.txt          → min 64-char random string
# ./secrets/aes_key.txt             → 32-byte hex (openssl rand -hex 32)
# ./secrets/scanner_api_key.txt     → min 32-char random string
# ./secrets/encryption_key.txt      → 32-byte hex (same format as aes_key)
# ./secrets/minio_root_password.txt → strong random password
# ./secrets/anthropic_api_key.txt   → sk-ant-... key from console.anthropic.com

# ── Database ─────────────────────────────────────────────────
POSTGRES_USER=ptaas
POSTGRES_DB=ptaas_db
# DATABASE_URL is constructed from secrets at runtime

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_strong_redis_password

# ── MinIO ────────────────────────────────────────────────────
MINIO_ROOT_USER=ptaas_minio
# MINIO_KMS_SECRET_KEY format: "key-name:base64-encoded-32-byte-key"
# Generate: openssl rand -base64 32 | tr -d '\n' → use as base64 part
MINIO_KMS_SECRET_KEY=ptaas-evidence-key:REPLACE_WITH_BASE64_32_BYTES

# ── JWT ──────────────────────────────────────────────────────
# Written to ./secrets/jwt_secret.txt (not here — secrets only)

# ── API ──────────────────────────────────────────────────────
# Internal URL used by the web frontend (server-side rendering)
PUBLIC_API_URL=https://your-domain.example.com

# ── ZAP ──────────────────────────────────────────────────────
ZAP_API_KEY=replace_with_strong_random_key

# ── Nginx TLS ─────────────────────────────────────────────────
# Paths to TLS certificate and private key on the host
NGINX_SSL_CERT=/etc/letsencrypt/live/your-domain.example.com/fullchain.pem
NGINX_SSL_KEY=/etc/letsencrypt/live/your-domain.example.com/privkey.pem

# ── Cloudflare Tunnel ─────────────────────────────────────────
# Obtain from: Cloudflare Zero Trust → Networks → Tunnels → Create tunnel
CLOUDFLARE_TUNNEL_TOKEN=eyJ...

# ── Mail (SMTP) ───────────────────────────────────────────────
SMTP_HOST=smtp.your-provider.example.com
SMTP_PORT=587
SMTP_USER=noreply@your-domain.example.com
SMTP_PASS=your_smtp_password
MAIL_FROM=PTaaS <noreply@your-domain.example.com>

# ── Backup ────────────────────────────────────────────────────
BACKUP_SCHEDULE=0 2 * * *    # daily at 02:00 UTC
BACKUP_RETENTION_DAYS=7

# ── Feature flags ─────────────────────────────────────────────
# NVD API key (optional — increases rate limit from 5/30s to 50/30s)
NVD_API_KEY=

# ── Monitoring (optional) ─────────────────────────────────────
# SENTRY_DSN=https://...@sentry.io/...
